# Apache / cPanel production config for the MTS Logistics static site.

# ---------- Basics ----------
DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  # Older shared hosts do not always know these types.
  AddType image/webp                  .webp
  AddType image/svg+xml               .svg
  AddType application/manifest+json   .webmanifest
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---------- Caching ----------
# NOTE: asset filenames are NOT content-hashed. When replacing a css/js/image file,
# change its filename (e.g. -v2) or these 1-year rules will keep serving the old copy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType application/pdf           "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML always revalidates
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Fingerprinted / versioned static assets
  <FilesMatch "\.(webp|png|svg|css|js|pdf|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ---------- Error document ----------
# Domain root. If the site is installed in a subfolder, use the full path,
# e.g. ErrorDocument 404 /subfolder/404.html
ErrorDocument 404 /404.html

# ---------- MTS favicon package (v20260801) ----------
# Icons are versioned with ?v= in the HTML, but /favicon.ico is requested
# implicitly without a query string — keep it revalidating.
<IfModule mod_headers.c>
  <FilesMatch "^(favicon\.ico|favicon-(16x16|32x32|48x48)\.png|apple-touch-icon\.png|android-chrome-(192x192|512x512)\.png|android-chrome-512x512-maskable\.png|manifest\.json)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresByType image/x-icon                "access plus 1 hour"
  ExpiresByType application/manifest+json   "access plus 1 hour"
</IfModule>

# ---------- Canonical host (matches official domain: https://www.mts-world.com/) ----------
# Only fires for the production hostname, so staging/GitHub Pages deployments are untouched.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^mts-world\.com$ [NC]
  RewriteRule ^(.*)$ https://www.mts-world.com/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?mts-world\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://www.mts-world.com/$1 [R=301,L]
</IfModule>
